{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/joesobo/codegraphy-registry/main/schemas/theme-release.schema.json",
  "title": "CodeGraphy theme release metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "manifest", "url", "sha256", "releaseNotes"],
  "properties": {
    "formatVersion": { "const": 1 },
    "manifest": { "$ref": "theme-package.schema.json#/properties/manifest" },
    "url": { "type": "string", "pattern": "^https://" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "releaseNotes": { "type": "string", "maxLength": 4000 }
  }
}
