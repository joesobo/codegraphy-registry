{
  "name": "codegraphy-registry",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build-registry-themes.ts",
    "check": "bun scripts/build-registry-themes.ts && git diff --exit-code -- themes && bun scripts/check.ts && bunx tsc && bun test",
    "theme:build": "bun scripts/theme-package.ts",
    "check:remote": "bun scripts/check.ts --remote"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/css-tree": "2.3.11",
    "ajv": "8.18.0",
    "css-tree": "3.2.1"
  },
  "license": "MIT"
}
