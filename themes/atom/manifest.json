{
  "formatVersion": 1,
  "kind": "theme",
  "id": "atom",
  "name": "Atom",
  "version": "1.2.0",
  "description": "Atom One Light and One Dark colors, adapted for CodeGraphy. Maintained by CodeGraphy.",
  "author": "CodeGraphy",
  "modes": [
    "light",
    "dark"
  ],
  "minimumCodeGraphyVersion": "0.1.9",
